
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. SUPER ADMIN
// ============================================================

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  role      String   @default("superadmin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 2. ADMIN (SCHOOL ACCOUNT)
// ============================================================

model Admin {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  password            String
  name                String
  schoolName          String
  schoolCode          String?   @unique
  studentLimit        Int       @default(0)
  currentStudentCount Int       @default(0)
  expiryDate          DateTime
  isActive            Boolean   @default(true)
  deactivatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  allowedFeatures Json?

  students              Student[]
  teachers              Teacher[]
  classes               Class[]
  subjects              Subject[]
  sessions              Session[]
  terms                 Term[]
  tests                 Test[]
  questions             Question[]
  questionSets          QuestionSet[]
  submissions           StudentSubmission[]
  attendances           Attendance[]
  continuousAssessments ContinuousAssessment[]
  gradingSystems        GradingSystem[]
  classTeacherComments  ClassTeacherComment[]
  teacherComments       TeacherComment[]
  principalComments     PrincipalComment[]
  resultAccessSchedules ResultAccessSchedule[]
  schoolOpenDays        SchoolOpenDays[]
  siteInformation       SiteInformation?
  teacherAssignments    TeacherAssignment[]
  resultPins            ResultPin[]
  testAttempts          TestAttempt[]

  networkSettings Json?
}

// ============================================================
// 3. ADMIN REGISTRATION TOKEN
// ============================================================

model AdminToken {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  schoolName   String?
  studentLimit Int       @default(0)
  expiryDate   DateTime?
  isUsed       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  allowedFeatures Json?
}

// ============================================================
// 4. SITE INFORMATION
// ============================================================

model SiteInformation {
  id      Int   @id @default(autoincrement())
  adminId Int   @unique
  admin   Admin @relation(fields: [adminId], references: [id])

  schoolName         String @default("")
  shortName          String @default("")
  schoolMotto        String @default("")
  address            String @default("")
  state              String @default("")
  country            String @default("Nigeria")
  phoneNumber        String @default("")
  email              String @default("")
  website            String @default("")
  registrationNumber String @default("")
  principalName      String @default("")

  schoolLogo         Json?
  principalSignature Json?
  schoolStamp        Json?

  admissionPrefix  String @default("SCH")
  admissionCounter Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 5. SUBJECT
// ============================================================

model Subject {
  id          Int      @id @default(autoincrement())
  adminId     Int
  admin       Admin    @relation(fields: [adminId], references: [id])

  name        String
  code        String
  classLevel  String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, code])
  @@index([adminId])
}

// ============================================================
// 6. TEACHER
// ============================================================

model Teacher {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  firstName     String
  lastName      String
  email         String
  username      String
  password      String
  phone         String?
  address       String?
  qualification String?
  experience    Int     @default(0)
  subjects      Int[]

  lastLogin       DateTime?
  lastLoginIP     String    @default("")
  lastLoginDevice String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eNoteWeeks ENoteWeek[]

  @@unique([adminId, email])
  @@unique([adminId, username])
  @@index([adminId])
}

// ============================================================
// 7. CLASS
// ============================================================

model Class {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  name      String
  level     String
  section   String
  session   String
  teacherId Int
  capacity  Int
  subjects  Int[]
  students  Int[]
  category  String?

  isActive Boolean @default(true)

  resultAccessBlocked Boolean   @default(false)
  resultBlockReason   String    @default("")
  resultBlockedAt     DateTime?
  resultBlockedBy     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eNoteWeeks ENoteWeek[]

  @@unique([adminId, name, level, section, session])
  @@index([adminId])
}

// ============================================================
// 8. STUDENT
// ============================================================

model Student {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  firstName       String
  lastName        String
  admissionNumber String?
  classId         Int?
  gender          String?

  owingFees         Boolean @default(false)
  feesAccessGranted Boolean @default(false)
  isDeleted         Boolean @default(false)

  profileImage Json?

  resultAccessBlocked Boolean   @default(false)
  resultBlockReason   String    @default("")
  resultBlockedAt     DateTime?
  resultBlockedBy     Int?

  testResults Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resultPins   ResultPin[]
  testAttempts TestAttempt[]

  @@unique([adminId, admissionNumber])
  @@index([adminId])
}

// ============================================================
// 9. SESSION
// ============================================================

model Session {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// ============================================================
// 10. TERM
// ============================================================

model Term {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  name           String
  sessionId      Int
  startDate      DateTime
  endDate        DateTime
  nextTermBegins DateTime?

  status   String  @default("upcoming")
  isActive Boolean @default(true)

  eNoteWeeks    ENoteWeek[]
  aiLessonNotes AILessonNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name, sessionId])
  @@index([adminId])
}

// ============================================================
// 11. TEST
// ============================================================

model Test {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  title        String
  classId      Int
  subjectId    Int
  duration     Int
  startDate    DateTime
  endDate      DateTime
  passMark     Int
  instructions String?
  questions    Json

  createdById Int

  isActive         Boolean   @default(true)
  resultsPublished Boolean   @default(false)
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testAttempts TestAttempt[]

  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// ============================================================
// 12. QUESTION
// ============================================================

model Question {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  classId       Int
  subjectId     Int
  questionText  String
  options       String[]
  correctAnswer Int
  difficulty    String   @default("medium")
  explanation   String?
  teacherId     Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// ============================================================
// 13. QUESTION SET
// ============================================================

model QuestionSet {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  title     String
  classId   Int
  subjectId Int
  teacherId Int
  questions Json

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, title])
  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// ============================================================
// 14. STUDENT SUBMISSION
// ============================================================

model StudentSubmission {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  classId       Int
  subjectId     Int
  questionText  String
  options       String[]
  correctAnswer Int
  explanation   String?
  studentId     Int

  status   String  @default("pending")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, classId, studentId])
  @@index([adminId])
}

// ============================================================
// 15. ATTENDANCE
// ============================================================

model Attendance {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId    Int
  classId      Int
  term         String
  session      String
  timesPresent Int    @default(0)
  teacherId    Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, classId, term, session])
  @@index([adminId])
}

// ============================================================
// 16. CONTINUOUS ASSESSMENT
// ============================================================

model ContinuousAssessment {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId Int
  classId   Int
  subjectId Int
  termId    Int
  sessionId Int
  teacherId Int

  testScore       Int @default(0)
  noteTakingScore Int @default(0)
  assignmentScore Int @default(0)
  totalCA         Int @default(0)

  examScore  Int @default(0)
  totalScore Int @default(0)

  grade  String @default("")
  remark String @default("")

  sourceTestId Int?
  status       String    @default("draft")
  approvedBy   Int?
  approvedAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, classId, subjectId, termId, sessionId])
  @@index([adminId])
}

// ============================================================
// 17. GRADING SYSTEM
// ============================================================

model GradingSystem {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  name      String
  grades    Json
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// ============================================================
// 18. CLASS TEACHER COMMENT
// ============================================================

model ClassTeacherComment {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId Int
  classId   Int
  teacherId Int
  comment   String
  term      String
  session   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, classId, term, session])
  @@index([adminId])
}

// ============================================================
// 19. TEACHER COMMENT
// ============================================================

model TeacherComment {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId Int
  classId   Int
  subjectId Int
  teacherId Int
  termId    Int
  sessionId Int

  comment         String
  effortRating    String @default("")
  behaviourRating String @default("")

  status      String    @default("draft")
  submittedAt DateTime?
  approvedBy  Int?
  approvedAt  DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, classId, subjectId, termId, sessionId])
  @@index([adminId])
}

// ============================================================
// 20. PRINCIPAL COMMENT
// ============================================================

model PrincipalComment {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId           Int
  termId              Int
  sessionId           Int
  classId             Int?
  comment             String
  percentage          Int     @default(0)
  classTeacherComment String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, termId, sessionId])
  @@index([adminId])
}

// ============================================================
// 21. RESULT ACCESS SCHEDULE
// ============================================================

model ResultAccessSchedule {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  termId          Int
  sessionId       Int
  resultStartTime DateTime
  resultDeadline  DateTime

  message  String  @default("Results are not available at this time. Please check back later.")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, termId, sessionId])
  @@index([adminId])
}

// ============================================================
// 22. SCHOOL OPEN DAYS
// ============================================================

model SchoolOpenDays {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  termId    Int
  sessionId Int
  timesOpen Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, termId, sessionId])
  @@index([adminId])
}

// ============================================================
// 23. TEACHER ASSIGNMENT
// ============================================================

model TeacherAssignment {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  teacherId Int
  classId   Int
  subjectId Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, teacherId, classId, subjectId])
  @@index([adminId])
}

// ============================================================
// 24. E-NOTES WEEK
// ============================================================

model ENoteWeek {
  id    Int    @id @default(autoincrement())
  title String

  classId   Int
  teacherId Int?
  adminId   Int

  termId Int
  term   Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  files         ENoteFile[]
  aiLessonNotes AILessonNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, termId, classId])
  @@index([classId, teacherId])
}

// ============================================================
// 25. E-NOTES FILE
// ============================================================

model ENoteFile {
  id          Int     @id @default(autoincrement())
  fileName    String
  fileUrl     String
  weekId      Int
  subjectId   Int?
  subjectName String?

  week ENoteWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekId])
}

// ============================================================
// 26. RESULT PIN
// ============================================================

model ResultPin {
  id      Int   @id @default(autoincrement())
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  pin       String @unique
  termId    Int
  sessionId Int

  usageCount Int @default(0)

  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, termId, sessionId])
}

// ============================================================
// 27. TEST ATTEMPT
// ============================================================

model TestAttempt {
  id Int @id @default(autoincrement())

  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  testId Int
  test   Test @relation(fields: [testId], references: [id])

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  status String @default("in_progress")

  answers Json?

  score          Int?
  totalQuestions Int?
  percentage     Int?
  passed          Boolean?

  isAutoSubmitted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, studentId, testId])
  @@index([adminId, studentId])
  @@index([adminId, testId])
  @@index([adminId, status])
  @@index([expiresAt])
}

// ============================================================
// 28. REFRESH TOKEN
// ============================================================

model RefreshToken {
  id            Int       @id @default(autoincrement())
  tokenHash     String    @unique
  tokenFamilyId String
  userId        Int
  role          String
  adminId       Int?
  deviceId      String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, role])
  @@index([adminId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

// ============================================================
// 29. NERDC CURRICULUM
// ============================================================

model NERDCCurriculum {
  id Int @id @default(autoincrement())

  classLevel String
  subject    String
  term       String
  week       Int
  topic      String

  subTopics              Json?
  learningObjectives     Json?
  content                String?
  activities             Json?
  instructionalMaterials Json?
  evaluation             Json?
  references             Json?

  curriculumSource String?
  curriculumYear   String?
  version          String?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonNotes AILessonNote[]

  @@unique([classLevel, subject, term, week])
  @@index([classLevel, subject, term])
}


// ============================================================
// 30. AI GENERATED LESSON NOTES
// ============================================================

model AILessonNote {
  id Int @id @default(autoincrement())

  // School
  adminId Int

  // Creator information
  // Null for administrator-created notes.
  teacherId     Int?
  createdByRole String @default("teacher")

  // Class and subject
  classId   Int
  subjectId Int

  // Lesson information
  term           String
  week           Int?
  topic          String
  subTopics      Json?
  lessonDuration Int?

  // Academic term relationship
  termId     Int?
  termRecord Term? @relation(fields: [termId], references: [id], onDelete: SetNull)

  // E-Notes week relationship
  weekId     Int?
  weekRecord ENoteWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  weekTitle String?

  // NERDC curriculum relationship
  curriculumId Int?
  curriculum   NERDCCurriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  curriculumSource String?

  // Generated content
  title   String
  content Json

  // ==========================================================
  // CLOUDINARY PDF DOCUMENT
  // ==========================================================

  // Secure Cloudinary PDF URL
  pdfUrl String?

  // Cloudinary public ID used to retrieve/delete the PDF
  pdfPublicId String?

  // PDF metadata
  pdfFileName    String?
  pdfMimeType    String?   @default("application/pdf")
  pdfSize        Int?
  pdfGeneratedAt DateTime?

  // AI configuration
  aiProvider String @default("groq")
  aiModel    String?

  // draft, saved, archived
  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([adminId, teacherId])
  @@index([adminId, createdByRole])
  @@index([adminId, classId, subjectId])
  @@index([adminId, term, week])
  @@index([termId])
  @@index([weekId])
  @@index([curriculumId])
  @@index([adminId, status])
  @@index([pdfPublicId])
}
